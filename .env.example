# Phiên bản Elastic Stack (ES và Kibana phải cùng version)
STACK_VERSION=9.5.5
CLUSTER_NAME=elk-cluster

# Mật khẩu user "elastic" (đăng nhập Kibana) và "kibana_system" (Kibana -> ES)
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme

# 3 khoá mã hoá Kibana, mỗi khoá >= 32 ký tự (openssl rand -hex 16)
KIBANA_SECURITY_KEY=
KIBANA_SAVEDOBJECTS_KEY=
KIBANA_REPORTING_KEY=

# 127.0.0.1 = chỉ truy cập từ máy này; 0.0.0.0 = mở cho mạng LAN
BIND_ADDR=127.0.0.1
ES_PORT=9200
KIBANA_PORT=5601
KIBANA_PUBLIC_URL=https://localhost:5601

# Hostname bổ sung cho chứng chỉ, cách nhau dấu phẩy (LAB_IP tự được thêm vào SAN)
CERT_EXTRA_DNS=
CERT_DAYS=1095

# Plugin ES cài lúc build, cách nhau dấu cách (vd: analysis-icu)
ES_PLUGINS=

# Thời gian giữ log (ILM logs-retention): xoá index sau N ngày kể từ rollover hằng ngày
LOG_RETENTION=7d

ES_HEAP=1g
ES_MEM_LIMIT=2g
KIBANA_MEM_LIMIT=1536m
KIBANA_NODE_HEAP_MB=1024

# ---- Fleet / VMware LAB ----
# IP của host trên mạng VMware (VMnet3 "LAB") — VM gửi log tới IP này
LAB_IP=10.20.20.1
FLEET_PORT=8220
FLEET_MEM_LIMIT=768m
